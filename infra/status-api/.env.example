# Beszel hub, by its container name on proxy_network and its internal port
BESZEL_URL=http://beszel:8090
# A Beszel user that can read the VPS system (a read-only user is enough)
BESZEL_EMAIL=
BESZEL_PASSWORD=
# The VPS's name in Beszel (leave empty to use the first system)
BESZEL_SYSTEM=
# Sites allowed to read the status from a browser
ALLOW_ORIGINS=https://www.mohammadramiz.in,https://mohammadramiz.in,http://localhost:3000
CACHE_SECONDS=20
